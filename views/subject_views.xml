<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subject_list" model="ir.ui.view">
        <field name="name">student.subject.list</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="semester"/>
            </list>
        </field>
    </record>

    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">student.subject.form</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="semester"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subject_search" model="ir.ui.view">
        <field name="name">student.subject.search</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="department_ids"/>
            </search>
        </field>
    </record>

    <record id="action_subject" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">student.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subject_search"/>
    </record>
</odoo>
