<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_classroom_room_list" model="ir.ui.view">
        <field name="name">student.classroom.room.list</field>
        <field name="model">student.classroom.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="room_number"/>
                <field name="batch_id"/>
                <field name="department_id"/>
                <field name="course_id"/>
            </list>
        </field>
    </record>

    <record id="view_student_classroom_room_form" model="ir.ui.view">
        <field name="name">student.classroom.room.form</field>
        <field name="model">student.classroom.room</field>
        <field name="arch" type="xml">
            <form string="Classroom">
                <sheet>
                    <group>
                        <field name="room_number"/>
                        <field name="batch_id"/>
                        <field name="department_id" domain="[('id', '=', batch_id.course_id.id)]"/>
                        <field name="course_id" domain="[('department_ids', 'in', [department_id]), ('semester', '=', batch_id.semester)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_student_classroom_room_search" model="ir.ui.view">
        <field name="name">student.classroom.room.search</field>
        <field name="model">student.classroom.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_number"/>
                <field name="batch_id"/>
                <field name="department_id"/>
                <field name="course_id"/>
            </search>
        </field>
    </record>

    <record id="action_student_classroom_room" model="ir.actions.act_window">
        <field name="name">Classrooms</field>
        <field name="res_model">student.classroom.room</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_student_classroom_room_search"/>
    </record>
</odoo>
