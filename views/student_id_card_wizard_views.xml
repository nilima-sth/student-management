<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_id_card_wizard_form" model="ir.ui.view">
        <field name="name">student.id.card.wizard.form</field>
        <field name="model">student.id.card.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Student ID Card">
                <sheet>
                    <group>
                        <field name="student_id"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Print ID Card" type="object" name="print_id_card" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_student_id_card_wizard" model="ir.actions.act_window">
        <field name="name">Student ID Card</field>
        <field name="res_model">student.id.card.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_student_id_card_wizard_form"/>
    </record>
</odoo>
