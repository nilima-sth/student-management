<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_report_list" model="ir.ui.view">
        <field name="name">student.report.list</field>
        <field name="model">student.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="report_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_student_report_search" model="ir.ui.view">
        <field name="name">student.report.search</field>
        <field name="model">student.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="view_student_report_form" model="ir.ui.view">
        <field name="name">student.report.form</field>
        <field name="model">student.report</field>
        <field name="arch" type="xml">
            <form string="Student Report">
                    <header>
                        <button name="%(student_management.report_student_report_action)d" string="Preview" type="action" class="oe_highlight" target="new"/>
                        <button name="%(student_management.report_student_report_action)d" string="Download" type="action" class="btn btn-secondary"/>
                    </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="student_id"/>
                        <field name="report_date"/>
                        <field name="state"/>
                        <field name="remarks"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="course_id"/>
                            <field name="full_marks"/>
                            <field name="pass_marks"/>
                            <field name="obtained_marks"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_report" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">student.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_student_report_search"/>
    </record>
</odoo>
