<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_course_list" model="ir.ui.view">
        <field name="name">student.course.list</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="semesters_count"/>
                <field name="fee_per_semester"/>
            </list>
        </field>
    </record>

    <record id="view_course_form" model="ir.ui.view">
        <field name="name">student.course.form</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="semesters_count"/>
                        <field name="fee_per_semester"/>
                    </group>
                    <notebook>
                        <page string="Sem 1">
                            <group>
                                <field name="code" readonly="1"/>
                            </group>
                            <field name="sem1_subject_ids" nolabel="1"/>
                        </page>
                        <page string="Sem 2">
                            <group>
                                <field name="code" readonly="1"/>
                            </group>
                            <field name="sem2_subject_ids" nolabel="1"/>
                        </page>
                        <page string="Sem 3">
                            <group>
                                <field name="code" readonly="1"/>
                            </group>
                            <field name="sem3_subject_ids" nolabel="1"/>
                        </page>
                        <page string="Sem 4">
                            <group>
                                <field name="code" readonly="1"/>
                            </group>
                            <field name="sem4_subject_ids" nolabel="1"/>
                        </page>
                        <page string="Sem 5">
                            <group>
                                <field name="code" readonly="1"/>
                            </group>
                            <field name="sem5_subject_ids" nolabel="1"/>
                        </page>
                        <page string="Sem 6">
                            <group>
                                <field name="code" readonly="1"/>
                            </group>
                            <field name="sem6_subject_ids" nolabel="1"/>
                        </page>
                        <page string="Sem 7">
                            <group>
                                <field name="code" readonly="1"/>
                            </group>
                            <field name="sem7_subject_ids" nolabel="1"/>
                        </page>
                        <page string="Sem 8">
                            <group>
                                <field name="code" readonly="1"/>
                            </group>
                            <field name="sem8_subject_ids" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_course_search" model="ir.ui.view">
        <field name="name">student.course.search</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Department</field>
        <field name="res_model">student.course</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
