<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <record id="view_partner_form_inherit_student" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.student</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_student" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>

            <xpath expr="//field[@name='company_name']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="invisible">is_student</attribute>
            </xpath>

            <xpath expr="//field[@name='function']" position="before">
                <field name="date_of_birth" invisible="not is_student"/>
                <field name="age" readonly="1" invisible="not is_student"/>
                <field name="enrollment_date" invisible="not is_student"/>
                <field name="course_ids" widget="many2many_tags" invisible="not is_student"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Guardian Details" name="guardian_details" invisible="not is_student">
                    <field name="guardian_ids" context="{'default_student_id': id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="relationship"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </list>
                        <form>
                            <group>
                                <field name="name"/>
                                <field name="relationship"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="address"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>

            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_admit" string="Admit" type="object" class="btn-primary"
                        invisible="not is_student or student_state in ['admitted', 'cancelled']"/>
                    <button name="action_cancel_student" string="Cancel" type="object"
                        invisible="not is_student or student_state == 'cancelled'"/>
                    <field name="student_state" widget="statusbar"
                        options="{'clickable': 1}"
                        statusbar_visible="admitted,completed,not_completed,cancelled"
                        invisible="not is_student"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_partner_accounting_inherit_student" model="ir.ui.view">
        <field name="name">res.partner.accounting.inherit.student</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="invisible">is_student or (not is_company and parent_id)</attribute>
            </xpath>
            <xpath expr="//page[@name='accounting_disabled']" position="attributes">
                <attribute name="invisible">is_student or is_company or not parent_id</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list default_order="name asc">
                <field name="name"/>
                <field name="date_of_birth"/>
                <field name="age"/>
                <field name="email"/>
                <field name="course_ids" widget="many2many_tags"/>
                <field name="enrollment_date"/>
                <field name="student_state"/>
            </list>
        </field>
    </record>
    
    <record id="view_student_kanban" model="ir.ui.view">
        <field name="name">student.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban default_order="name asc">
                <field name="image_1920"/>
                <field name="name"/>
                <field name="email"/>
                <field name="date_of_birth"/>
                <field name="age"/>
                <field name="student_state"/>
                <field name="course_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="mb-2">
                                <field name="image_1920" widget="image" class="oe_kanban_avatar" options="{'size': [96, 96]}"/>
                            </div>
                            <div class="fw-bold fs-5">
                                <field name="name"/>
                            </div>
                            <div class="text-muted">
                                <field name="email"/>
                            </div>
                            <div>
                                Age: <field name="age"/>
                            </div>
                            <div>
                                DOB: <field name="date_of_birth"/>
                            </div>
                            <div>
                                Status: <field name="student_state"/>
                            </div>
                            <div class="mt-2">
                                <field name="course_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_student_calendar" model="ir.ui.view">
        <field name="name">student.calendar</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <calendar string="Students" date_start="enrollment_date" color="student_state">
                <field name="name"/>
                <field name="student_state"/>
                <field name="course_ids"/>
            </calendar>
        </field>
    </record>

    <record id="view_student_search" model="ir.ui.view">
        <field name="name">student.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="adult" string="Adults" domain="[('age','>=',18)]"/>
                <filter name="active_students" string="Active" domain="[('student_state','=','active')]"/>
                <filter name="completed_students" string="Completed" domain="[('student_state','=','completed')]"/>
            </search>
        </field>
    </record>

    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="search_view_id" ref="view_student_search"/>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context" eval="{'default_is_student': True, 'default_company_type': 'person', 'default_country_id': ref('base.np')}"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_student_tree')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_student_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')}),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_student_calendar')})]"/>
    </record>

</odoo>
