<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.tree</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_of_birth"/>
                <field name="age"/>
                <field name="email"/>
                <field name="course_ids" widget="many2many_tags"/>
                <field name="enrollment_date"/>
                <field name="state"/>
                <field name="is_adult"/>
            </list>
        </field>
    </record>

    <record id="view_student_kanban" model="ir.ui.view">
        <field name="name">student.kanban</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="image_1920"/>
                <field name="name"/>
                <field name="email"/>
                <field name="date_of_birth"/>
                <field name="age"/>
                <field name="state"/>
                <field name="course_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="mb-2">
                                <field name="image_1920" widget="image" class="oe_kanban_avatar"/>
                            </div>
                            <div class="fw-bold fs-5">
                                <field name="name"/>
                            </div>
                            <div class="text-muted">
                                <field name="email"/>
                            </div>
                            <div>
                                Age: <field name="age"/>
                            </div>
                            <div>
                                DOB: <field name="date_of_birth"/>
                            </div>
                            <div>
                                Status: <field name="state"/>
                            </div>
                            <div class="mt-2">
                                <field name="course_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


<record id="view_student_form" model="ir.ui.view">
    <field name="name">student.form</field>
    <field name="model">student.student</field>
    <field name="arch" type="xml">
        <form string="Student">
            <header>
                <button name="action_admit" type="object" string="Admit" class="btn-success" invisible="state == 'admitted'"/>
                <button name="action_set_not_admitted" type="object" string="Set Not Admitted" class="btn-secondary" invisible="state == 'not_admitted'"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group>
                        <field name="name"/>
                        <field name="date_of_birth"/>
                    </group>
                    <group>
                        
                        <field name="age" readonly="1"/>
                        <field name="email"/>
                        <field name="course_ids" widget="many2many_tags"/>
                        <field name="enrollment_date"/>
                        <field name="is_adult" readonly="1"/>
                    </group>
                </group>
            </sheet>
        <chatter/>
        </form>
        
    </field>
</record>

<record id="view_student_search" model="ir.ui.view">
    <field name="name">student.search</field>
    <field name="model">student.student</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <filter name="adult" string="Adults" domain="[('age','>=',18)]"/>
        </search>
    </field>
</record>

<record id="action_student" model="ir.actions.act_window">
    <field name="name">Students</field>
    <field name="res_model">student.student</field>
    <field name="view_mode">list,kanban,form</field>
</record>

</odoo>