<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_guardian_tree" model="ir.ui.view">
        <field name="name">student.guardian.tree</field>
        <field name="model">student.guardian</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="relationship"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_guardian_form" model="ir.ui.view">
        <field name="name">student.guardian.form</field>
        <field name="model">student.guardian</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="student_id"/>
                        <field name="relationship"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_guardian" model="ir.actions.act_window">
        <field name="name">Guardians</field>
        <field name="res_model">student.guardian</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>