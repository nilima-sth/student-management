<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_attendance_tree" model="ir.ui.view">
        <field name="name">student.attendance.tree</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="room_number"/>
                <field name="classroom_id"/>
                <field name="department_id"/>
                <field name="subject_id"/>
                <field name="present_count"/>
                <field name="absent_count"/>
            </list>
        </field>
    </record>

    <record id="view_student_attendance_form" model="ir.ui.view">
        <field name="name">student.attendance.form</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <form string="Classroom">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="room_number"/>
                        <field name="classroom_id"/>
                        <field name="department_id"/>
                        <field name="subject_id"/>
                        <field name="teacher_id"/>
                        <field name="present_count" readonly="1"/>
                        <field name="absent_count" readonly="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="student_id" readonly="1"/>
                            <field name="present"/>
                            <field name="remarks"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_student_attendance_search" model="ir.ui.view">
        <field name="name">student.attendance.search</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <field name="room_number"/>
                <field name="classroom_id"/>
                <field name="department_id"/>
                <field name="subject_id"/>
            </search>
        </field>
    </record>

    <record id="view_student_attendance_kanban" model="ir.ui.view">
        <field name="name">student.attendance.kanban</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="date"/>
                <field name="classroom_id"/>
                <field name="department_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="present_count"/>
                <field name="absent_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record">
                            <div class="o_kanban_primary_bottom">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_secondary">
                                <div><strong>Date:</strong> <field name="date"/></div>
                                <div><strong>Batch:</strong> <field name="classroom_id"/></div>
                                <div><strong>Department:</strong> <field name="department_id"/></div>
                                <div><strong>Course:</strong> <field name="subject_id"/></div>
                                <div><strong>Marked By:</strong> <field name="teacher_id"/></div>
                                <div><field name="present_count"/> Present / <field name="absent_count"/> Absent</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_student_attendance" model="ir.actions.act_window">
        <field name="name">Classroom</field>
        <field name="res_model">student.attendance</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_student_attendance_tree"/>
        <field name="search_view_id" ref="view_student_attendance_search"/>
    </record>
</odoo>
