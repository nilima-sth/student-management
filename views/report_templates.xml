<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_student_id_card_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div style="width:85mm;height:55mm;border:1.6px solid #2f69b1;border-radius:4px;background:#ffffff;box-sizing:border-box;font-family:monospace;color:#16365f;display:flex;flex-direction:column;overflow:hidden;page-break-inside:avoid;break-inside:avoid;">
                    <div style="padding:2.2mm 3mm 1.8mm 3mm;border-bottom:1.2px solid #2f69b1;display:flex;justify-content:space-between;align-items:flex-start;gap:2mm;">
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:4.6mm;font-weight:700;line-height:1;letter-spacing:0.2px;">STUDENT ID CARD</div>
                            <div style="font-size:2.8mm;line-height:1.1;margin-top:1mm;">Student Management</div>
                        </div>
                        <div style="width:10mm;height:10mm;border:1px solid #2f69b1;padding:1mm;box-sizing:border-box;border-radius:2px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#ffffff;">
                            <img t-if="o.company_id and o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Institution Logo"
                                 style="width:100%;height:100%;object-fit:contain;"/>
                            <span t-if="not (o.company_id and o.company_id.logo)" style="font-size:2.2mm;color:#2f69b1;text-align:center;line-height:1;">LOGO</span>
                        </div>
                    </div>

                    <div style="padding:2mm 3mm;display:flex;gap:2.2mm;align-items:flex-start;flex:1;min-height:0;">
                        <div style="width:18mm;min-width:18mm;height:22mm;border:1.2px solid #2f69b1;border-radius:2px;overflow:hidden;background:#f5f9ff;">
                            <img t-if="o.image_1920" t-att-src="image_data_uri(o.image_1920)" alt="Student Photo"
                                 style="width:100%;height:100%;object-fit:cover;"/>
                            <div t-if="not o.image_1920" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2.4mm;color:#2f69b1;">PHOTO</div>
                        </div>
                        <div style="flex:1;min-width:0;font-size:2.9mm;line-height:1.25;">
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong>Name:</strong> <span t-esc="o.name or '-'"/></div>
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong>Roll:</strong> <span t-esc="o.roll_no or '-'"/></div>
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong>Program:</strong> <span t-esc="', '.join(o.course_ids.mapped('name')) or '-'"/></div>
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong>Section:</strong> <span t-esc="o.section or '-'"/></div>
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong>Batch:</strong> <span t-esc="o.classroom_id.name if o.classroom_id else '-'"/></div>
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong>Contact:</strong> <span t-esc="o.phone or o.mobile or '-'"/></div>
                        </div>
                    </div>

                    <div style="padding:1.8mm 3mm;border-top:1px solid #2f69b1;background:#2f69b1;color:#ffffff;text-align:center;font-size:2.7mm;line-height:1;">
                        www.yourcollege.edu
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_student_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div class="header" style="text-align: center; margin-bottom: 10px;">
                        <img src="/student_management/static/description/icon.png" alt="Shrestha College Logo" style="max-height:80px; display:block; margin:0 auto 10px;"/>
                        <h2>Shrestha College</h2>
                        <h4>Student Report</h4>
                    </div>

                    <table class="table table-sm" style="width:100%; border-collapse: collapse;">
                        <tr>
                            <td><strong>Report Ref:</strong> <span t-esc="o.name"/></td>
                            <td><strong>Date:</strong> <span t-esc="o.report_date"/></td>
                        </tr>
                        <tr>
                            <td colspan="2"><strong>Student:</strong> <span t-esc="o.student_id.name"/></td>
                        </tr>
                    </table>

                    <br/>

                    <table class="table table-sm" style="width:100%; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Department</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Full Marks</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Pass Marks</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Obtained</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Result</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.line_ids" t-as="l">
                                <tr>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.course_id.name"/>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.full_marks"/>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.pass_marks"/>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.obtained_marks"/>
                                    <td style="border: 1px solid #000; padding:4px;"> <t t-esc="l.result and 'Pass' or 'Fail'"/> </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <br/>
                    <br/>
                    <div style="text-align: right;">
                        <strong>Total Obtained Marks: </strong>
                        <span t-esc="o.total_obtained"/>
                    </div>
                    <br/>
                    <div><strong>Remarks:</strong></div>
                    <div t-raw="o.remarks or ''"/>
                </div>
            </t>
        </t>
    </template>

    <record id="paperformat_student_id_card" model="report.paperformat">
        <field name="name">Student ID Card Format</field>
        <field name="format">custom</field>
        <field name="page_width">85</field>
        <field name="page_height">55</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
    </record>

    <record id="report_student_id_card_preview_action" model="ir.actions.report">
        <field name="name">Student ID Card Preview</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">student_management.report_student_id_card_document</field>
        <field name="print_report_name">(object.name or 'Student') + ' - ID Card'</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_student_report_preview_action" model="ir.actions.report">
        <field name="name">Student Report Preview</field>
        <field name="model">student.report</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">student_management.report_student_report_document</field>
        <field name="print_report_name">object.name</field>
    </record>

    <record id="report_student_report_action" model="ir.actions.report">
        <field name="name">Student Report</field>
        <field name="model">student.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_report_document</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <record id="report_student_id_card_action" model="ir.actions.report">
        <field name="name">Student ID Card</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_id_card_document</field>
        <field name="print_report_name">(object.name or 'Student') + ' - ID Card'</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="student_management.paperformat_student_id_card"/>
    </record>

</odoo>
