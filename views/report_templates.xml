<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_student_id_card_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="display:flex;justify-content:center;padding-top:20px;">
                    <IdentityCard template="Student_ID_v1" theme="Blue_Outline"
                        style="width:320px;min-height:560px;border:2px solid #4A90E2;font-family:monospace;color:#4A90E2;background:#ffffff;box-sizing:border-box;display:flex;flex-direction:column;">

                        <Header style="padding:16px;">
                            <Title alignment="center" color="#4A90E2" font-style="monospace"
                                style="text-align:center;font-size:16px;margin-bottom:20px;">
                                STUDENT IDENTITY CARD
                            </Title>

                            <LogoBox type="placeholder"
                                style="width:140px;height:50px;border:2px solid #4A90E2;margin:0 auto 20px auto;display:flex;align-items:center;justify-content:center;text-align:center;">
                                COLLEGE LOGO
                            </LogoBox>

                            <IdentityMedia style="width:160px;height:120px;border:2px solid #4A90E2;margin-bottom:15px;padding:8px;box-sizing:border-box;overflow:hidden;">
                                <img t-if="o.image_1920" t-att-src="image_data_uri(o.image_1920)" alt="Student Photo"
                                    style="width:100%;height:100%;object-fit:cover;"/>
                                <t t-if="not o.image_1920">
                                    STUDENT<br/>PHOTO
                                </t>
                            </IdentityMedia>

                            <PrimaryInfo>
                                <div style="margin-bottom:4px;">
                                    Name:<span t-esc="o.name" style="margin-left:8px;"/>
                                </div>
                                <div>
                                    Address:<span t-esc="', '.join(filter(None, [o.street, o.street2, o.city]))" style="margin-left:8px;"/>
                                </div>
                            </PrimaryInfo>
                        </Header>

                        <Divider style="border-top:2px solid #4A90E2;"/>

                        <StudentDetailsMenu style="padding:16px;line-height:1.5;">
                            <Entry id="program" label="Program: " value="{program_title}">
                                Program:<span t-esc="', '.join(o.course_ids.mapped('name'))" style="margin-left:8px;"/>
                            </Entry>
                            <Entry id="section" label="Section: " value="{section_id}">
                                Section:<span t-esc="o.section or ''" style="margin-left:8px;"/>
                            </Entry>
                            <Entry id="roll_no" label="Roll No: " value="{roll_number}">
                                Roll No:<span t-esc="o.roll_no or ''" style="margin-left:8px;"/>
                            </Entry>
                            <Entry id="contact" label="Contact: " value="{phone_number}">
                                Contact:<span t-esc="o.phone or o.mobile or ''" style="margin-left:8px;"/>
                            </Entry>
                            <Entry id="address_alt" label="Address: " value="{permanent_address}">
                                Address:<span t-esc="', '.join(filter(None, [o.street, o.street2, o.city]))" style="margin-left:8px;"/>
                            </Entry>
                            <Entry id="email" label="Email: " value="{email_address}">
                                Email:<span t-esc="o.email or ''" style="margin-left:8px;"/>
                            </Entry>
                            <Entry id="validity" label="Validity: " value="{expiry_date}">
                                Validity:<span t-esc="o.student_state or ''" style="margin-left:8px;"/>
                            </Entry>
                        </StudentDetailsMenu>

                        <AppIcons style="display:flex;justify-content:center;gap:10px;padding:8px 16px 12px 16px;">
                            <img src="/student_management/static/description/icon.png" alt="App Icon"
                                style="width:22px;height:22px;border:1px solid #4A90E2;padding:2px;box-sizing:border-box;"/>
                            <img src="/student_management/static/description/icon.png" alt="App Icon"
                                style="width:22px;height:22px;border:1px solid #4A90E2;padding:2px;box-sizing:border-box;"/>
                            <img src="/student_management/static/description/icon.png" alt="App Icon"
                                style="width:22px;height:22px;border:1px solid #4A90E2;padding:2px;box-sizing:border-box;"/>
                        </AppIcons>

                        <Footer>
                            <BorderStrip height="24px" style="border-top:2px solid #4A90E2;height:24px;margin-top:auto;"/>
                        </Footer>
                    </IdentityCard>
                </div>
            </t>
        </t>
    </template>

    <template id="report_student_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div class="header" style="text-align: center; margin-bottom: 10px;">
                        <img src="/student_management/static/description/icon.png" alt="Shrestha College Logo" style="max-height:80px; display:block; margin:0 auto 10px;"/>
                        <h2>Shrestha College</h2>
                        <h4>Student Report</h4>
                    </div>

                    <table class="table table-sm" style="width:100%; border-collapse: collapse;">
                        <tr>
                            <td><strong>Report Ref:</strong> <span t-esc="o.name"/></td>
                            <td><strong>Date:</strong> <span t-esc="o.report_date"/></td>
                        </tr>
                        <tr>
                            <td colspan="2"><strong>Student:</strong> <span t-esc="o.student_id.name"/></td>
                        </tr>
                    </table>

                    <br/>

                    <table class="table table-sm" style="width:100%; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Department</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Full Marks</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Pass Marks</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Obtained</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Result</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.line_ids" t-as="l">
                                <tr>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.course_id.name"/>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.full_marks"/>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.pass_marks"/>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.obtained_marks"/>
                                    <td style="border: 1px solid #000; padding:4px;"> <t t-esc="l.result and 'Pass' or 'Fail'"/> </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <br/>
                    <br/>
                    <div style="text-align: right;">
                        <strong>Total Obtained Marks: </strong>
                        <span t-esc="o.total_obtained"/>
                    </div>
                    <br/>
                    <div><strong>Remarks:</strong></div>
                    <div t-raw="o.remarks or ''"/>
                </div>
            </t>
        </t>
    </template>

    <record id="report_student_report_preview_action" model="ir.actions.report">
        <field name="name">Student Report Preview</field>
        <field name="model">student.report</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">student_management.report_student_report_document</field>
        <field name="print_report_name">object.name</field>
    </record>

    <record id="report_student_report_action" model="ir.actions.report">
        <field name="name">Student Report</field>
        <field name="model">student.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_report_document</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <record id="report_student_id_card_action" model="ir.actions.report">
        <field name="name">Student ID Card</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_id_card_document</field>
        <field name="print_report_name">(object.name or 'Student') + ' - ID Card'</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
