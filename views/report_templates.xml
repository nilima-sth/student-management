<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_student_id_card_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div style="width:100%; height:100%; background:#ffffff; border:1.2px solid #2f69b1; box-sizing:border-box; font-family:monospace; color:#16365f; display:flex; flex-direction:column; overflow:hidden; page-break-inside:avoid; break-inside:avoid;">
                    
                    <div style="padding:1.5mm 0 0.5mm 0; text-align:center;">
                        <div style="font-size:2.2mm; font-weight:700; line-height:1; letter-spacing:0.3px; text-transform:uppercase;">
                            STUDENT ID CARD
                        </div>
                    </div>

                    <div style="display:flex; justify-content:center; padding-bottom:1.5mm;">
                        <div style="width:12mm; height:12mm; border:1px solid #2f69b1; padding:1mm; box-sizing:border-box; border-radius:3px; display:flex; align-items:center; justify-content:center; background:#f5f9ff;">
    <t t-set="company" t-value="res_company"/>
    <img t-if="company.logo" 
         t-att-src="image_data_uri(company.logo)" 
         alt="College Logo"
         style="max-width:100%; max-height:100%; display:block; object-fit:contain;"/>
    <span t-if="not company.logo" style="font-size:2mm; color:#2f69b1;">LOGO</span>
</div>
                    </div>

                    <div style="border-bottom:1.2px solid #2f69b1; width:100%;"></div>

                    <div style="display:flex; flex-direction:column; align-items:center; flex:1;">
                        
                        <div style="padding-top:2mm; padding-bottom:1.5mm;">
                            <div style="width:22mm; height:24mm; border:1.2px solid #2f69b1; border-radius:2px; overflow:hidden; background:#f5f9ff;">
                                <img t-if="o.image_1920" t-att-src="image_data_uri(o.image_1920)" alt="Student Photo"
                                     style="width:100%; height:100%; object-fit:cover;"/>
                                <div t-if="not o.image_1920" style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:2.2mm; color:#2f69b1;">PHOTO</div>
                            </div>
                        </div>

                        <div style="width:100%; text-align:center; padding:0 2mm;">
                            <div style="font-weight:700; font-size:2.8mm; color:#16365f; margin-bottom:0.5mm;">
                                <span t-esc="o.name or '-'"/>
                            </div>
                            <div style="font-size:2.4mm; line-height:1.1; margin-bottom:1.5mm;">
                                <span t-esc="', '.join(filter(None, [o.street, o.street2, o.city])) or '-'"/>
                            </div>
                        </div>

                        <div style="border-bottom:1.2px solid #2f69b1; width:100%; margin-bottom:1.5mm;"></div>

                        <div style="width:100%; font-size:2.4mm; line-height:1.3; display:flex; flex-direction:column; gap:0.2mm; text-align:left; padding:0 4mm;">
                            <div><strong>Roll No:</strong> <span t-esc="o.roll_no or '-'"/></div>
                            <div><strong>Section:</strong> <span t-esc="o.section or '-'"/></div>
                            <div><strong>Contact:</strong> <span t-esc="o.phone or o.mobile or '-'"/></div>
                            <div style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                <strong>Email:</strong> <span t-esc="o.email or '-'"/>
                            </div>
                        </div>

                    </div>

                    <div style="padding:1.5mm 0; background:#2f69b1; color:#ffffff; text-align:center; font-size:2.5mm; margin-top:auto;">
                        www.sxc.edu.np
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_student_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div class="header" style="text-align: center; margin-bottom: 10px;">
                        <img src="/student_management/static/description/icon.png" alt="Shrestha College Logo" style="max-height:80px; display:block; margin:0 auto 10px;"/>
                        <h2>Shrestha College</h2>
                        <h4>Student Report</h4>
                    </div>

                    <table class="table table-sm" style="width:100%; border-collapse: collapse;">
                        <tr>
                            <td><strong>Report Ref:</strong> <span t-esc="o.name"/></td>
                            <td><strong>Date:</strong> <span t-esc="o.report_date"/></td>
                        </tr>
                        <tr>
                            <td><strong>Student:</strong> <span t-esc="o.student_id.name"/></td>
                            <td><strong>Roll Number:</strong> <span t-esc="o.student_id.roll_no or '-'"/></td>
                        </tr>
                        <tr>
                            <td><strong>Department:</strong>
                                <span t-esc="', '.join(o.student_id.course_ids.mapped('name')) or '-'"/>
                            </td>
                            <td><strong>Batch:</strong> <span t-esc="o.student_id.classroom_id.name or '-'"/></td>
                        </tr>
                    </table>

                    <br/>

                    <table class="table table-sm" style="width:100%; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Course</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Full Marks</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Pass Marks</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Obtained</strong></th>
                                <th style="border: 1px solid #000; padding:4px;"><strong>Result</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.line_ids" t-as="l">
                                <tr>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.course_id.name"/>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.full_marks"/>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.pass_marks"/>
                                    <td style="border: 1px solid #000; padding:4px;" t-esc="l.obtained_marks"/>
                                    <td style="border: 1px solid #000; padding:4px;"> <t t-esc="l.result and 'Pass' or 'Fail'"/> </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <br/>
                    <br/>
                    <div style="text-align: right;">
                        <strong>Total Obtained Marks: </strong>
                        <span t-esc="o.total_obtained"/>
                    </div>
                    <br/>
                    <div><strong>Remarks:</strong></div>
                    <div t-raw="o.remarks or ''"/>
                </div>
            </t>
        </t>
    </template>

    <record id="paperformat_student_id_card" model="report.paperformat">
        <field name="name">Student ID Card Format</field>
        <field name="format">custom</field>
        <field name="page_width">45</field>
        <field name="page_height">70</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
    </record>

    <record id="report_student_id_card_preview_action" model="ir.actions.report">
        <field name="name">Student ID Card Preview</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">student_management.report_student_id_card_document</field>
        <field name="print_report_name">(object.name or 'Student') + ' - ID Card'</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_student_report_preview_action" model="ir.actions.report">
        <field name="name">Student Report Preview</field>
        <field name="model">student.report</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">student_management.report_student_report_document</field>
        <field name="print_report_name">object.name</field>
    </record>

    <record id="report_student_report_action" model="ir.actions.report">
        <field name="name">Student Report</field>
        <field name="model">student.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_report_document</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <record id="report_student_id_card_action" model="ir.actions.report">
        <field name="name">Student ID Card</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_id_card_document</field>
        <field name="print_report_name">(object.name or 'Student') + ' - ID Card'</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="student_management.paperformat_student_id_card"/>
    </record>

</odoo>
