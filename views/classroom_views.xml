<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_classroom_kanban" model="ir.ui.view">
        <field name="name">student.classroom.kanban</field>
        <field name="model">student.classroom</field>
        <field name="arch" type="xml">
            <kanban default_group_by="semester">
                <field name="program"/>
                <field name="name"/>
                <field name="semester"/>
                <field name="class_teacher"/>
                <field name="student_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record">
                            <div class="o_kanban_primary_bottom">
                                <strong><field name="name"/></strong>
                            </div>
                            <div>
                                Program: <field name="program"/>
                            </div>
                            <div>
                                Semester: <field name="semester"/>
                            </div>
                            <div>
                                Teacher: <field name="class_teacher"/>
                            </div>
                            <div>
                                Students: <field name="student_count"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_student_classroom_form" model="ir.ui.view">
        <field name="name">student.classroom.form</field>
        <field name="model">student.classroom</field>
        <field name="arch" type="xml">
            <form string="Classroom">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="program"/>
                        <field name="semester"/>
                        <field name="course_id" domain="[('program', '=', program)]"/>
                        <field name="class_teacher"/>
                        <field name="subject_ids" widget="many2many_tags" domain="[('course_id', '=', course_id)]"/>
                        <field name="student_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="student_ids" context="{'default_is_student': True, 'default_company_type': 'person'}">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="roll_no"/>
                                <field name="subject_ids" widget="many2many_tags"/>
                            </list>
                            <form string="Student">
                                <group>
                                    <field name="name"/>
                                    <field name="roll_no"/>
                                    <field name="subject_ids" widget="many2many_tags"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_student_classroom_search" model="ir.ui.view">
        <field name="name">student.classroom.search</field>
        <field name="model">student.classroom</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="program"/>
                <field name="semester"/>
                <field name="course_id"/>
                <field name="class_teacher"/>
            </search>
        </field>
    </record>

    <record id="action_student_student_batch_bim" model="ir.actions.act_window">
        <field name="name">BIM Batch</field>
        <field name="res_model">student.classroom</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_student_classroom_kanban"/>
        <field name="domain">[('program','=','bim')]</field>
        <field name="search_view_id" ref="view_student_classroom_search"/>
    </record>

    <record id="action_student_student_batch_csit" model="ir.actions.act_window">
        <field name="name">CSIT Batch</field>
        <field name="res_model">student.classroom</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_student_classroom_kanban"/>
        <field name="domain">[('program','=','csit')]</field>
        <field name="search_view_id" ref="view_student_classroom_search"/>
    </record>

    <record id="action_student_classroom" model="ir.actions.act_window">
        <field name="name">Classrooms</field>
        <field name="res_model">student.classroom</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_student_classroom_kanban"/>
        <field name="search_view_id" ref="view_student_classroom_search"/>
    </record>
</odoo>
